generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum Role {
  ADMIN
  DIRECTOR
  SERVICE_ADVISOR
  TECHNICIAN
}

enum PersonType {
  FISICA
  MORAL
}

enum ClientSegment {
  NUEVO
  FRECUENTE
  ANTIGUO
}

enum VehicleType {
  AUTO
  CAMIONETA
  CAMION
}

enum ServiceCategory {
  AFINACION_Y_MANTENIMIENTO
  FRENOS_Y_SUSPENSION
  MECANICA_GENERAL
  MECANICA_RAPIDA
  ELECTRICO_Y_DIAGNOSTICO
  TORNO_Y_MAQUINADO
}

enum ArticleType {
  PARTE_EN_VENTA
  CONSUMIBLE
}

enum ToolCondition {
  NUEVO
  BUENO
  REGULAR
  DANADO
}

enum ToolStatus {
  DISPONIBLE
  EN_USO
  EN_MANTENIMIENTO
  DADO_DE_BAJA
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum OperationalStatus {
  RECIBIDA
  EN_DIAGNOSTICO
  EN_ESPERA_COTIZACION
  EN_ESPERA_APROBACION
  EN_REPARACION
  CONTROL_CALIDAD
  LISTA_PARA_ENTREGA
  ENTREGADA
  CERRADA
  EN_GARANTIA
  CANCELADA
}

enum CommercialStatus {
  SIN_COTIZAR
  COTIZADA
  APROBADA_PARCIAL
  APROBADA_TOTAL
  EN_EJECUCION
  CIERRE_PENDIENTE
  COBRADA_PARCIAL
  COBRADA_TOTAL
}

enum BillingStatus {
  NO_REQUERIDA
  PENDIENTE_DATOS
  LISTA_PARA_FACTURAR
  FACTURADA
  CANCELADA
}

enum QuotationApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuotationLineType {
  SERVICE
  PART
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PhotoCategory {
  RECEPTION
  INSPECTION
  PROCESS
  QUALITY_CONTROL
  DELIVERY
}

model Workshop {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  specialOrderParts SpecialOrderPart[]
  suppliers     Supplier[]
  articles      Article[]
  tools         Tool[]
  custodyItems  CustodyItem[]
  services      Service[]
  workOrders    WorkOrder[]
}

model User {
  id           String   @id @default(cuid())
  workshopId   String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  kpiTitle     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop                Workshop         @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  refreshTokens           RefreshToken[]
  userPermissions         UserPermission[]
  custodyItemsResponsible CustodyItem[]
  assignedTools           Tool[]
  workOrdersAsAdvisor     WorkOrder[]      @relation("WorkOrderAdvisor")
  otNotes                 OtNote[]
  otPhotos                OtPhoto[]
  quotationLineOverrides  QuotationLine[]  @relation("QuotationLineOverrides")

  @@index([workshopId])
  @@index([email])
  @@index([role])
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  label String

  userPermissions UserPermission[]
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  workshopId String
  entityType String
  entityId   String
  action     String
  actorId    String
  before     Json?
  after      Json?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([workshopId, createdAt])
  @@index([actorId])
}

model Client {
  id         String        @id @default(cuid())
  workshopId String
  personType PersonType
  name       String
  rfc        String?
  phone      String
  email      String?
  address    String?
  hasDebt    Boolean       @default(false)
  segment    ClientSegment @default(NUEVO)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  vehicles     Vehicle[]
  custodyItems CustodyItem[]
  workOrders   WorkOrder[]

  @@unique([workshopId, rfc])
  @@index([workshopId])
  @@index([workshopId, segment])
  @@index([workshopId, hasDebt])
  @@index([phone])
  @@index([name])
}

model Vehicle {
  id         String   @id @default(cuid())
  workshopId String
  clientId   String
  plate      String
  vin        String?
  make       String
  model      String
  year       Int
  km         Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  custodyItems CustodyItem[]
  workOrders   WorkOrder[]

  @@unique([workshopId, vin])
  @@index([workshopId])
  @@index([workshopId, plate])
  @@index([clientId])
}

model SpecialOrderPart {
  id          String   @id @default(cuid())
  workshopId  String
  sku         String
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)

  @@unique([workshopId, sku])
  @@index([workshopId])
  @@index([name])
}

model Service {
  id               String          @id @default(cuid())
  workshopId       String
  code             String?
  concept          String
  category         ServiceCategory
  system           String
  family           String?
  estimatedMinutes Int?
  basePrice        Decimal?        @db.Decimal(12, 2)
  costPrice        Decimal?        @db.Decimal(12, 2)
  notes            String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workshop Workshop       @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  prices   ServicePrice[]
  quotationLines QuotationLine[]

  @@unique([workshopId, code])
  @@index([workshopId])
  @@index([workshopId, category])
  @@index([concept])
}

model ServicePrice {
  id          String      @id @default(cuid())
  serviceId   String
  vehicleType VehicleType
  price       Decimal     @db.Decimal(12, 2)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, vehicleType])
  @@index([serviceId])
}

model Supplier {
  id          String   @id @default(cuid())
  workshopId  String
  name        String
  contactName String?
  phone       String
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop Workshop  @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  articles Article[]

  @@index([workshopId])
  @@index([name])
}

model Article {
  id             String            @id @default(cuid())
  workshopId     String
  supplierId     String?
  sku            String?
  oemNumber      String?
  type           ArticleType
  name           String
  description    String?
  brand          String?
  location       String?
  isSpecialOrder Boolean           @default(false)
  purchasePrice  Decimal?          @db.Decimal(12, 2)
  salePrice      Decimal?          @db.Decimal(12, 2)
  photoUrl       String?
  stock          Int               @default(0)
  minStock       Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workshop  Workshop        @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements StockMovement[]
  quotationLines QuotationLine[]

  @@unique([workshopId, sku])
  @@index([workshopId])
  @@index([workshopId, type])
  @@index([supplierId])
  @@index([name])
  @@index([oemNumber])
}

model Tool {
  id                String        @id @default(cuid())
  workshopId        String
  serialNumber      String?
  name              String
  brand             String?
  description       String?
  condition         ToolCondition @default(BUENO)
  status            ToolStatus    @default(DISPONIBLE)
  purchasePrice     Decimal?      @db.Decimal(12, 2)
  assignedToUserId  String?
  lastMaintenanceAt DateTime?
  notes             String?
  photoUrl          String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([assignedToUserId])
  @@index([workshopId, status])
  @@index([name])
}

model StockMovement {
  id          String            @id @default(cuid())
  workshopId  String
  articleId   String
  workOrderId String?
  type        StockMovementType
  qty         Int
  before      Int
  after       Int
  unitCost    Decimal?          @db.Decimal(12, 2)
  reason      String?
  actorId     String
  createdAt   DateTime          @default(now())

  article   Article    @relation(fields: [articleId], references: [id], onDelete: Restrict)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([workshopId])
  @@index([actorId])
  @@index([workOrderId])
}

model CustodyItem {
  id                String    @id @default(cuid())
  workshopId        String
  clientId          String
  vehicleId         String?
  description       String
  workOrderCode     String?
  responsibleUserId String?
  photoUrl          String?
  receivedAt        DateTime  @default(now())
  returnedAt        DateTime?
  isReturned        Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  responsible User?    @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([responsibleUserId])
  @@index([workshopId, isReturned])
}

model WorkOrder {
  id                 String            @id @default(cuid())
  workshopId         String
  code               String
  clientId           String
  vehicleId          String
  serviceAdvisorId   String
  operationalStatus  OperationalStatus @default(RECIBIDA)
  commercialStatus   CommercialStatus  @default(SIN_COTIZAR)
  billingStatus      BillingStatus     @default(NO_REQUERIDA)
  estaRetrasada      Boolean           @default(false)
  portalToken        String            @unique @default(uuid())
  mileageIn          Int?
  fuelLevel          Int?
  failureDescription String
  diagnosis          String?
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workshop       Workshop               @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle        Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceAdvisor User                   @relation("WorkOrderAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: Restrict)
  checklist      OtReceptionChecklist?
  notes          OtNote[]
  photos         OtPhoto[]
  quotation      Quotation?
  stockMovements StockMovement[]

  @@unique([workshopId, code])
  @@index([workshopId])
  @@index([workshopId, operationalStatus])
  @@index([serviceAdvisorId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([createdAt, id])
}

model OtReceptionChecklist {
  id              String   @id @default(cuid())
  workOrderId     String   @unique
  hasKeys         Boolean  @default(true)
  hasSpareTire    Boolean  @default(false)
  hasJack         Boolean  @default(false)
  hasTools        Boolean  @default(false)
  hasExtinguisher Boolean  @default(false)
  exteriorDamage  Json?
  personalItems   String?
  notes           String?
  createdAt       DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model OtNote {
  id              String   @id @default(cuid())
  workOrderId     String
  userId          String
  content         String
  isClientVisible Boolean  @default(false)
  createdAt       DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@index([workOrderId, isClientVisible])
}

model OtPhoto {
  id          String        @id @default(cuid())
  workOrderId String
  userId      String
  category    PhotoCategory @default(RECEPTION)
  url         String
  caption     String?
  isPublic    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
}

model Quotation {
  id                   String                  @id @default(cuid())
  workOrderId          String                  @unique
  subtotal             Decimal                 @default(0.00) @db.Decimal(12, 2)
  discountType         DiscountType?
  discountValue        Decimal?                @db.Decimal(12, 2)
  aplicaIva            Boolean                 @default(true)
  taxAmount            Decimal                 @default(0.00) @db.Decimal(12, 2)
  total                Decimal                 @default(0.00) @db.Decimal(12, 2)
  clientApprovalStatus QuotationApprovalStatus @default(PENDING)
  approvedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  workOrder WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lines     QuotationLine[]
}

model QuotationLine {
  id                  String                  @id @default(cuid())
  quotationId         String
  lineType            QuotationLineType
  serviceId           String?
  articleId           String?
  concept             String
  quantity            Int                     @default(1)
  unitPrice           Decimal                 @db.Decimal(12, 2)
  finalPrice          Decimal                 @db.Decimal(12, 2)
  priceOverrideReason String?
  priceOverrideById   String?
  approvalStatus      QuotationApprovalStatus @default(PENDING)
  rejectionReason     String?
  reQuotedFromLineId  String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  quotation         Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service           Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  article           Article?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  overrideBy        User?          @relation("QuotationLineOverrides", fields: [priceOverrideById], references: [id], onDelete: SetNull)
  reQuotedFromLine  QuotationLine? @relation("ReQuotedLines", fields: [reQuotedFromLineId], references: [id], onDelete: SetNull)
  reQuotedFollowUps QuotationLine[] @relation("ReQuotedLines")

  @@index([quotationId])
  @@index([approvalStatus])
}



