generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum Role {
  ADMIN
  DIRECTOR
  SERVICE_ADVISOR
  TECHNICIAN
}

enum PersonType {
  FISICA
  MORAL
}

enum ClientSegment {
  NUEVO
  FRECUENTE
  ANTIGUO
}

enum PriceListItemType {
  SERVICE
  PART
}

enum ArticleType {
  HERRAMIENTA
  CONSUMIBLE
  EQUIPO
  PARTE_EN_VENTA
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

model Workshop {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  priceListItems PriceListItem[]
  suppliers     Supplier[]
  articles      Article[]
  custodyItems  CustodyItem[]
}

model User {
  id           String   @id @default(cuid())
  workshopId   String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  kpiTitle     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop        Workshop         @relation(fields: [workshopId], references: [id])
  refreshTokens   RefreshToken[]
  userPermissions UserPermission[]

  @@index([workshopId])
  @@index([email])
  @@index([role])
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  label String

  userPermissions UserPermission[]
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  workshopId String
  entityType String
  entityId   String
  action     String
  actorId    String
  before     Json?
  after      Json?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([workshopId, createdAt])
  @@index([actorId])
}

model Client {
  id         String        @id @default(cuid())
  workshopId String
  personType PersonType
  name       String
  rfc        String?
  phone      String
  email      String?
  address    String?
  hasDebt    Boolean       @default(false)
  segment    ClientSegment @default(NUEVO)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id])
  vehicles     Vehicle[]
  custodyItems CustodyItem[]

  @@unique([workshopId, rfc])
  @@index([workshopId])
  @@index([workshopId, segment])
  @@index([workshopId, hasDebt])
  @@index([phone])
  @@index([name])
}

model Vehicle {
  id         String   @id @default(cuid())
  workshopId String
  clientId   String
  plate      String
  vin        String?
  make       String
  model      String
  year       Int
  km         Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  custodyItems CustodyItem[]

  @@unique([workshopId, vin])
  @@index([workshopId])
  @@index([workshopId, plate])
  @@index([clientId])
}

model PriceListItem {
  id          String             @id @default(cuid())
  workshopId  String
  sku         String
  type        PriceListItemType
  name        String
  description String?
  unitPrice   Decimal            @db.Decimal(12, 2)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  @@unique([workshopId, sku])
  @@index([workshopId])
  @@index([workshopId, type])
  @@index([name])
}

model Supplier {
  id          String   @id @default(cuid())
  workshopId  String
  name        String
  contactName String?
  phone       String
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])

  @@index([workshopId])
  @@index([name])
}

model Article {
  id          String      @id @default(cuid())
  workshopId  String
  sku         String?
  type        ArticleType
  name        String
  description String?
  stock       Int         @default(0)
  minStock    Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workshop  Workshop        @relation(fields: [workshopId], references: [id])
  movements StockMovement[]

  @@unique([workshopId, sku])
  @@index([workshopId])
  @@index([workshopId, type])
  @@index([name])
}

model StockMovement {
  id          String            @id @default(cuid())
  workshopId  String
  articleId   String
  workOrderId String?
  type        StockMovementType
  qty         Int
  before      Int
  after       Int
  reason      String?
  actorId     String
  createdAt   DateTime          @default(now())

  article Article @relation(fields: [articleId], references: [id])

  @@index([articleId, createdAt])
  @@index([workshopId])
}

model CustodyItem {
  id          String    @id @default(cuid())
  workshopId  String
  clientId    String
  vehicleId   String?
  description String
  receivedAt  DateTime  @default(now())
  returnedAt  DateTime?
  isReturned  Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([workshopId])
  @@index([clientId])
  @@index([workshopId, isReturned])
}


