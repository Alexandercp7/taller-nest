generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum Role {
  ADMIN
  DIRECTOR
  SERVICE_ADVISOR
  TECHNICIAN
}

enum PersonType {
  FISICA
  MORAL
}

enum ClientSegment {
  NUEVO
  FRECUENTE
  ANTIGUO
}

enum VehicleType {
  AUTO
  CAMIONETA
  CAMION
}

enum ServiceCategory {
  AFINACION_Y_OTROS
  MECANICA_RAPIDA
  MECANICA_GENERAL
}

enum ArticleType {
  HERRAMIENTA
  CONSUMIBLE
  EQUIPO
  PARTE_EN_VENTA
}

enum ArticleCondition {
  NUEVO
  BUENO
  REGULAR
  DANADO
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

model Workshop {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  specialOrderParts SpecialOrderPart[]
  suppliers     Supplier[]
  articles      Article[]
  custodyItems  CustodyItem[]
  services      Service[]
  latheServices LatheService[]
}

model User {
  id           String   @id @default(cuid())
  workshopId   String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  kpiTitle     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop                Workshop         @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  refreshTokens           RefreshToken[]
  userPermissions         UserPermission[]
  custodyItemsResponsible CustodyItem[]

  @@index([workshopId])
  @@index([email])
  @@index([role])
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  label String

  userPermissions UserPermission[]
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  workshopId String
  entityType String
  entityId   String
  action     String
  actorId    String
  before     Json?
  after      Json?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([workshopId, createdAt])
  @@index([actorId])
}

model Client {
  id         String        @id @default(cuid())
  workshopId String
  personType PersonType
  name       String
  rfc        String?
  phone      String
  email      String?
  address    String?
  hasDebt    Boolean       @default(false)
  segment    ClientSegment @default(NUEVO)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  vehicles     Vehicle[]
  custodyItems CustodyItem[]

  @@unique([workshopId, rfc])
  @@index([workshopId])
  @@index([workshopId, segment])
  @@index([workshopId, hasDebt])
  @@index([phone])
  @@index([name])
}

model Vehicle {
  id         String   @id @default(cuid())
  workshopId String
  clientId   String
  plate      String
  vin        String?
  make       String
  model      String
  year       Int
  km         Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  custodyItems CustodyItem[]

  @@unique([workshopId, vin])
  @@index([workshopId])
  @@index([workshopId, plate])
  @@index([clientId])
}

model SpecialOrderPart {
  id          String   @id @default(cuid())
  workshopId  String
  sku         String
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)

  @@unique([workshopId, sku])
  @@index([workshopId])
  @@index([name])
}

model Service {
  id         String          @id @default(cuid())
  workshopId String
  category   ServiceCategory
  concept    String
  system     String
  family     String?
  notes      String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  workshop Workshop       @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  prices   ServicePrice[]

  @@index([workshopId])
  @@index([workshopId, category])
  @@index([concept])
}

model ServicePrice {
  id          String      @id @default(cuid())
  serviceId   String
  vehicleType VehicleType
  price       Decimal     @db.Decimal(12, 2)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, vehicleType])
  @@index([serviceId])
}

model LatheService {
  id         String   @id @default(cuid())
  workshopId String
  name       String
  size       String
  diameter   String
  price      Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)

  @@index([workshopId])
  @@index([name])
}

model Supplier {
  id          String   @id @default(cuid())
  workshopId  String
  name        String
  contactName String?
  phone       String
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)

  @@index([workshopId])
  @@index([name])
}

model Article {
  id            String            @id @default(cuid())
  workshopId    String
  sku           String?
  type          ArticleType
  name          String
  description   String?
  condition     ArticleCondition?
  purchasePrice Decimal?          @db.Decimal(12, 2)
  salePrice     Decimal?          @db.Decimal(12, 2)
  photoUrl      String?
  stock         Int               @default(0)
  minStock      Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workshop  Workshop        @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([workshopId, sku])
  @@index([workshopId])
  @@index([workshopId, type])
  @@index([name])
}

model StockMovement {
  id          String            @id @default(cuid())
  workshopId  String
  articleId   String
  workOrderId String?
  type        StockMovementType
  qty         Int
  before      Int
  after       Int
  reason      String?
  actorId     String
  createdAt   DateTime          @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([workshopId])
  @@index([actorId])
}

model CustodyItem {
  id                String    @id @default(cuid())
  workshopId        String
  clientId          String
  vehicleId         String?
  description       String
  workOrderCode     String?
  responsibleUserId String?
  photoUrl          String?
  receivedAt        DateTime  @default(now())
  returnedAt        DateTime?
  isReturned        Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  responsible User?    @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([responsibleUserId])
  @@index([workshopId, isReturned])
}


