### =============================================================
### taller-back — REST Client (VSCode extension "REST Client")
### =============================================================
### Prefijo /api/v1 configurado globalmente en main.ts.
### Ejecutar primero "Login" o "Login DIRECTOR": las siguientes
### requests reutilizan {{login.response.body.accessToken}} y
### {{login.response.body.refreshToken}} automáticamente.
### =============================================================

@baseUrl = http://localhost:3000/api/v1

### ID de usuario a usar en los endpoints /users/:id de más abajo
@userId = REEMPLAZAR_CON_UN_ID_REAL


## =====================================================
## AUTH — /auth
## =====================================================

### Login (ADMIN)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@taller.com",
  "password": "NuevaPassword1234!"
}

### Refresh token — rota el par access/refresh
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}

### Cambiar contraseña (autenticado) — revoca todas las sesiones del usuario
PATCH {{baseUrl}}/auth/password
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "currentPassword": "Admin1234!Secure",
  "newPassword": "NuevaPassword1234!"
}

### Logout — revoca el refresh token (o su familia)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}


## =====================================================
## USERS — /users  (requiere Authorization: Bearer <accessToken>)
## =====================================================

### Perfil del usuario autenticado
GET {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.accessToken}}

### Crear usuario — requiere permiso "user:manage" (ADMIN)
# @name createUser
POST {{baseUrl}}/users
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "email": "nuevo.tecnico@taller.com",
  "firstName": "Juan",
  "lastName": "Pérez",
  "password": "Password123!",
  "role": "TECHNICIAN",
  "kpiTitle": "Técnico Nivel 2"
}

### Listar usuarios — requiere permiso "user:manage"
### Filtros: page, limit (máx 100), includeInactive, role
GET {{baseUrl}}/users?page=1&limit=20&includeInactive=false
Authorization: Bearer {{login.response.body.accessToken}}

### Listar usuarios filtrando por rol
GET {{baseUrl}}/users?role=TECHNICIAN
Authorization: Bearer {{login.response.body.accessToken}}

### Actualizar usuario — requiere permiso "user:manage"
PATCH {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "firstName": "Juan Actualizado",
  "kpiTitle": "Técnico Senior",
  "role": "TECHNICIAN"
}

### Reemplazar permisos del usuario — requiere permiso "user:manage"
PUT {{baseUrl}}/users/{{userId}}/permissions
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "permissions": [
    { "permissionId": "REEMPLAZAR_CON_ID_DE_PERMISO", "granted": true }
  ]
}

### Desactivar usuario (soft-delete) — requiere permiso "user:manage"
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{login.response.body.accessToken}}

###
### SERVICIOS / MANO DE OBRA
###

### Crear servicio con matriz de precios por tipo de vehículo
# @name createService
POST {{baseUrl}}/services
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "code": "SRV-FREN-01",
  "concept": "Cambio de balatas delanteras",
  "category": "FRENOS_Y_SUSPENSION",
  "system": "Frenos",
  "family": "Discos",
  "estimatedMinutes": 60,
  "basePrice": "350.00",
  "costPrice": "150.00",
  "notes": "Incluye limpieza y lubricación de herrajes",
  "prices": [
    { "vehicleType": "AUTO", "price": "400.00" },
    { "vehicleType": "CAMIONETA", "price": "500.00" },
    { "vehicleType": "CAMION", "price": "700.00" }
  ]
}

### Listar servicios (resuelve precios para CAMIONETA)
GET {{baseUrl}}/services?vehicleType=CAMIONETA&page=1&limit=20
Authorization: Bearer {{login.response.body.accessToken}}

### Obtener servicio por ID
@serviceId = {{createService.response.body.id}}
GET {{baseUrl}}/services/{{serviceId}}?vehicleType=AUTO
Authorization: Bearer {{login.response.body.accessToken}}

### Actualizar servicio
PATCH {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "estimatedMinutes": 75,
  "basePrice": "380.00"
}

### Actualizar matriz de precios del servicio
PUT {{baseUrl}}/services/{{serviceId}}/prices
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "prices": [
    { "vehicleType": "AUTO", "price": "420.00" },
    { "vehicleType": "CAMIONETA", "price": "550.00" },
    { "vehicleType": "CAMION", "price": "750.00" }
  ]
}

### Desactivar servicio (soft-delete)
DELETE {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{login.response.body.accessToken}}

###
### ÓRDENES DE TRABAJO (WORK ORDERS)
###

### Crear Orden de Trabajo con recepción y checklist
# @name createWorkOrder
POST {{baseUrl}}/work-orders
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "clientId": "REEMPLAZAR_CON_CLIENT_ID",
  "vehicleId": "REEMPLAZAR_CON_VEHICLE_ID",
  "failureDescription": "Rechinido en frenos delanteros y vibración al frenar",
  "mileageIn": 65400,
  "fuelLevel": 50,
  "estimatedDelivery": "2026-10-10T18:00:00.000Z",
  "checklist": {
    "hasKeys": true,
    "hasSpareTire": true,
    "hasJack": true,
    "hasTools": false,
    "hasExtinguisher": false,
    "personalItems": "Gafas de sol en guantera",
    "exteriorDamage": [
      { "component": "puerta_delantera_derecha", "damageType": "rayon_ligero" }
    ]
  }
}

### Listar Órdenes de Trabajo (con filtros y búsqueda)
GET {{baseUrl}}/work-orders?page=1&limit=20&search=Sentra
Authorization: Bearer {{login.response.body.accessToken}}

### Obtener Detalle de Orden de Trabajo
@workOrderId = {{createWorkOrder.response.body.id}}
GET {{baseUrl}}/work-orders/{{workOrderId}}
Authorization: Bearer {{login.response.body.accessToken}}

### Avanzar Estado Operativo (validado por FSM)
POST {{baseUrl}}/work-orders/{{workOrderId}}/status
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "status": "EN_DIAGNOSTICO"
}

### Alternar flag de Orden Retrasada
PATCH {{baseUrl}}/work-orders/{{workOrderId}}/delayed
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "estaRetrasada": true
}

### Agregar Nota a la Orden de Trabajo
POST {{baseUrl}}/work-orders/{{workOrderId}}/notes
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "content": "Se verificó desgaste al 90% en balatas delanteras y discos con ceja pronunciada.",
  "isClientVisible": true
}

###
### COTIZACIONES (QUOTATIONS)
###

### Consultar Cotización de la Orden de Trabajo
GET {{baseUrl}}/work-orders/{{workOrderId}}/quotation
Authorization: Bearer {{login.response.body.accessToken}}

### Agregar Línea de Cotización (Mano de obra / Servicio)
# @name addServiceLine
POST {{baseUrl}}/work-orders/{{workOrderId}}/quotation/lines
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "lineType": "SERVICE",
  "serviceId": "REEMPLAZAR_CON_SERVICE_ID",
  "quantity": 1
}

### Agregar Línea de Cotización (Refacción)
# @name addPartLine
POST {{baseUrl}}/work-orders/{{workOrderId}}/quotation/lines
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "lineType": "PART",
  "articleId": "REEMPLAZAR_CON_ARTICLE_ID",
  "quantity": 1
}

### Ajuste de Precio con Motivo (Override)
@lineId = {{addServiceLine.response.body.id}}
PATCH {{baseUrl}}/work-orders/{{workOrderId}}/quotation/lines/{{lineId}}/override-price
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "finalPrice": "400.00",
  "reason": "Descuento por promoción de mantenimiento de frenos"
}

### Configurar Descuento Global e IVA
POST {{baseUrl}}/work-orders/{{workOrderId}}/quotation/discount
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "discountType": "PERCENT",
  "discountValue": "5.00",
  "aplicaIva": true
}

### Aprobar o Rechazar Líneas de Cotización por el Cliente
POST {{baseUrl}}/work-orders/{{workOrderId}}/quotation/approve
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "decisions": [
    {
      "lineId": "{{lineId}}",
      "status": "APPROVED"
    }
  ]
}

###
### CIERRE COMERCIAL (COMMERCIAL CLOSE)
###

### Confirmar Cierre Comercial de la Orden de Trabajo
# @name commercialClose
POST {{baseUrl}}/work-orders/{{workOrderId}}/commercial-close
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "requiresInvoice": true,
  "notes": "Cierre comercial confirmado por el asesor en entrega"
}

### Consultar Cierre Comercial de la Orden de Trabajo
GET {{baseUrl}}/work-orders/{{workOrderId}}/commercial-close
Authorization: Bearer {{login.response.body.accessToken}}

###
### PAGOS Y ANTICIPOS (PAYMENTS)
###

### Registrar Pago o Anticipo a la Orden de Trabajo
# @name createPayment
POST {{baseUrl}}/work-orders/{{workOrderId}}/payments
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "type": "FINAL_SETTLEMENT",
  "paymentMethod": "CARD",
  "amount": "400.00",
  "terminalCommission": "14.00",
  "reference": "AUTH-481920",
  "notes": "Pago con tarjeta de débito en terminal"
}

### Listar Historial de Pagos de la Orden
GET {{baseUrl}}/work-orders/{{workOrderId}}/payments
Authorization: Bearer {{login.response.body.accessToken}}

### Resumen Financiero de la Orden (Saldo, Totales y CxC)
GET {{baseUrl}}/work-orders/{{workOrderId}}/payments/summary
Authorization: Bearer {{login.response.body.accessToken}}

###
### FINANZAS Y CAJA (FINANCE)
###

### Listar Cuentas por Cobrar (CxC)
GET {{baseUrl}}/finance/receivables?page=1&limit=20&status=OPEN
Authorization: Bearer {{login.response.body.accessToken}}

### Consultar Movimientos del Flujo de Caja
GET {{baseUrl}}/finance/cash-movements
Authorization: Bearer {{login.response.body.accessToken}}

### Registrar Movimiento Manual de Caja (Ingreso o Egreso)
POST {{baseUrl}}/finance/cash-movements
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "type": "EXPENSE",
  "amount": "150.00",
  "concept": "Compra de café y artículos de limpieza de oficina"
}

### Reporte Financiero Consolidado
GET {{baseUrl}}/finance/report
Authorization: Bearer {{login.response.body.accessToken}}


###
### FACTURACIÓN INTERNA (INVOICING) — ADR-11
###

@invoiceId = REEMPLAZAR_CON_INVOICE_ID

### Consultar Bandeja de Facturación Pendiente (Diagnóstico fiscal)
GET {{baseUrl}}/invoicing/pending?page=1&limit=20
Authorization: Bearer {{login.response.body.accessToken}}

### Filtrar Bandeja por Estatus (LISTA_PARA_FACTURAR o PENDIENTE_DATOS)
GET {{baseUrl}}/invoicing/pending?status=LISTA_PARA_FACTURAR
Authorization: Bearer {{login.response.body.accessToken}}

### Actualizar y Validar Datos Fiscales de la Orden y Cliente
PUT {{baseUrl}}/invoicing/work-orders/{{workOrderId}}/fiscal-data
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "rfc": "PEPJ8001019Q8",
  "businessName": "JUAN PEREZ PEREZ",
  "zipCode": "03100",
  "taxRegime": "612",
  "cfdiUse": "G03",
  "applyToClient": true
}

### Emitir Factura Interna (Genera folio secuencial FAC-XXXX y snapshot)
# @name emitInvoice
POST {{baseUrl}}/invoicing/work-orders/{{workOrderId}}/emit
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "paymentMethodSat": "PUE",
  "paymentFormSat": "03",
  "notes": "Factura interna correspondiente a servicio y refacciones"
}

### Listar Histórico de Facturas Emitidas y Canceladas
GET {{baseUrl}}/invoicing/invoices?page=1&limit=20
Authorization: Bearer {{login.response.body.accessToken}}

### Consultar Detalle de una Factura por ID
GET {{baseUrl}}/invoicing/invoices/{{invoiceId}}
Authorization: Bearer {{login.response.body.accessToken}}

### Cancelar Factura Interna (Revierte OT a CANCELADA)
POST {{baseUrl}}/invoicing/invoices/{{invoiceId}}/cancel
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "satReasonCode": "02",
  "cancellationReason": "Comprobante emitido con error en RFC a petición del cliente"
}




