{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@common/(.*)$": "<rootDir>/../src/common/$1",
    "^@prisma-service/(.*)$": "<rootDir>/../src/prisma/$1",
    "^@audit/(.*)$": "<rootDir>/../src/audit/$1"
  }
}
